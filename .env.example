# Robinhood Chain. The public host is rpc.mainnet.chain.robinhood.com — rpc.robinhood.com does not resolve.
RHC_RPC=https://rpc.mainnet.chain.robinhood.com

# Shared secret Roblox game servers send as x-ponsblox-secret. Never put this in ReplicatedStorage.
ROBLOX_SERVER_SECRET=change-me

# Optional. Charts, trending, trenches. Create at https://gmgn.ai/ai
# Without it the site still reads the chain; kline/trending return empty.
GMGN_API_KEY=

# Public URL printed on Roblox QR codes and /sign links.
PUBLIC_WEB_URL=http://localhost:5173

# Live Roblox experience. The website Play button goes here.
VITE_ROBLOX_PLACE_ID=

# Open Cloud publish (existing experience only). Create the key on create.roblox.com
# with universe-places Write for this universe. This PC cannot reach Roblox.
ROBLOX_UNIVERSE_ID=
ROBLOX_PLACE_ID=
ROBLOX_API_KEY=

# Server listen port.
PORT=8787

# Local Pons V2 launch wallet. Never commit the key. Address only is safe to share.
LAUNCH_PRIVATE_KEY=
LAUNCH_ADDRESS=
PONS_PAIR=0x62fd0668e10D8B72339BE2DCF7643001688ff13B
TOKEN_NAME=Spooder-Man
TOKEN_SYMBOL=SPOODERMAN
TOKEN_TWITTER=
TOKEN_DESCRIPTION=
TOKEN_LOGO=
TOKEN_CREATOR_TAX_BPS=100
TOKEN_BUYBACK=false
TOKEN_QUOTE_IN=

# GitPad — GitHub proxy (5000 req/hr). Without it the live API still works, then rate-limits.
GITHUB_TOKEN=

# Optional GitPad X profile. Footer falls back to # until set.
VITE_GITPAD_X=

# Pinata JWT for real IPFS pins. Without it, GitPad will not invent a CID.
PINATA_JWT=

# After the GitPad contracts are deployed on Robinhood Chain:
VITE_GITPAD_ADAPTER=
VITE_GITPAD_REGISTRY=
VITE_GITPAD_METADATA=
VITE_GITPAD_FACTORY=
VITE_GITPAD_FEE_ROUTER=
VITE_GITPAD_TREASURY=
