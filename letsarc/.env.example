# Worker + signing (never expose to the browser)
LAUNCHER_PRIVATE_KEY=0x
ARC_RPC_URL=https://rpc.mainnet.arc.io

# X API — user-context tokens for @letslauncharc
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BOT_USER_ID=
X_BOT_USERNAME=letslauncharc

# Optional: faster than polling if your X project has Account Activity / filtered stream webhooks
X_WEBHOOK_SECRET=
X_BEARER_TOKEN=

# PostgreSQL
DATABASE_URL=postgres://user:pass@localhost:5432/letsarc

# Admin dashboard (Vercel / local Next)
ADMIN_SECRET=

# Optional image fallback if Argus /api/upload is down
PINATA_JWT=

POLL_INTERVAL_MS=2000
MIN_NATIVE_WEI=1000000000000000
DRY_RUN=0
