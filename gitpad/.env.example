# GitPad environment — names and descriptions only. Never commit real credentials.
# This stack is Vite, not Next.js. Browser-exposed values use the VITE_ prefix.
# Equivalent names from generic checklists:
#   NEXT_PUBLIC_CHAIN_ID        → VITE_ROBINHOOD_CHAIN_ID
#   NEXT_PUBLIC_RPC_URL         → VITE_ROBINHOOD_RPC
#   PONS_FACTORY_ADDRESS        → VITE_PONS_FACTORY
#   IPFS_API_KEY                → PINATA_JWT
# DATABASE_URL / REDIS_URL are unused in this build (file store at gitpad/.data).

# Public identifiers — confirm against https://docs.ponsfamily.com/v2
VITE_PONS_FACTORY=
VITE_PONS_LAUNCH_AND_BUY=
VITE_PONS_MEME_HOOK=
VITE_PONS_FEE_ESCROW=
VITE_PONS_BUYBACK_VAULT=
VITE_PONS_LAUNCH_LOCKER=
VITE_PONS_LAUNCH_DEPLOYER=
VITE_PONS_LAUNCH_CONFIG_ID=
# Native ETH (0x0). Leave empty.
VITE_PONS_PAIR=
VITE_ROBINHOOD_CHAIN_ID=
VITE_ROBINHOOD_RPC=
VITE_ROBINHOOD_EXPLORER=

# GitPad modules — set only after you deploy gitpad/contracts
VITE_GITPAD_ADAPTER=
VITE_GITPAD_REGISTRY=
VITE_GITPAD_METADATA=
VITE_GITPAD_FACTORY=
VITE_GITPAD_FEE_ROUTER=
VITE_GITPAD_TREASURY=
VITE_GITPAD_ADMINS=
VITE_GITPAD_X=https://x.com/LaunchGitLab

# Server-only secrets — never expose to the browser
GITHUB_TOKEN=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT=
PINATA_JWT=
BITQUERY_API_KEY=
